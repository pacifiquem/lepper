{
  "name": "lepper",
  "description": "Shared notes, preflight briefings, code maps, and blast radius for AI agents working on a codebase.",
  "version": "0.1.0",
  "bin": {
    "lepper": "./compiled/bin/lepper.js",
    "lepper-mcp": "./compiled/bin/lepper-mcp.js"
  },
  "files": [
    "compiled",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "lint": "eslint --ext .js,.ts",
    "lint:fix": "eslint --fix --ext .js,.ts",
    "compile": "tsc --pretty && babel --extensions '.ts' src -d compiled",
    "prepare": "node scripts/ensure-compiled.js",
    "prepublishOnly": "npm run compile",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "mcp": "node compiled/bin/lepper-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pacifiquem/lepper.git"
  },
  "keywords": [
    "lepper",
    "project",
    "project-management",
    "collaboration",
    "git",
    "mcp",
    "npx",
    "agents",
    "describe",
    "project-structure"
  ],
  "author": "pacifiquem@github.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pacifiquem/lepper/issues"
  },
  "homepage": "https://github.com/pacifiquem/lepper#readme",
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-typescript": "^7.23.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vitest": "^0.3.8",
    "husky": "^8.0.3",
    "lepper": "^0.0.1",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "commander": "^11.1.0"
  }
}
